+//! Owned objects for the bounded pilot. Keep parsing separate from display rules.
+use osmpbf::{Element, ElementReader, RelMemberType};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub type Tags = BTreeMap<String, String>;
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct NodeId(pub i64);
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct WayId(pub i64);
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct RelationId(pub i64);
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum OsmId {
+    Node(NodeId),
+    Way(WayId),
+    Relation(RelationId),
+}
+
+pub struct Node {
+    pub id: NodeId,
+    pub tags: Tags,
+    lat: i32,
+    lon: i32,
+}
+impl Node {
+    // Preserve the existing 1e-7 degree coordinate contract, including signed rounding.
+    pub fn lat(&self) -> f64 {
+        self.lat as f64 * 1e-7
+    }
+    pub fn lon(&self) -> f64 {
+        self.lon as f64 * 1e-7
+    }
+}
+pub struct Way {
+    pub id: WayId,
+    pub tags: Tags,
+    pub nodes: Vec<NodeId>,
+}
+impl Way {
+    pub fn is_closed(&self) -> bool {
+        self.nodes.first() == self.nodes.last()
+    }
+}
+pub struct Member {
+    pub member: OsmId,
+    pub role: String,
+}
+pub struct Relation {
+    pub id: RelationId,
+    pub tags: Tags,
+    pub refs: Vec<Member>,
+}
+pub enum OsmObj {
+    Node(Node),
+    Way(Way),
+    Relation(Relation),
+}
+impl OsmObj {
+    fn id(&self) -> OsmId {
+        match self {
+            Self::Node(n) => OsmId::Node(n.id),
+            Self::Way(w) => OsmId::Way(w.id),
+            Self::Relation(r) => OsmId::Relation(r.id),
+        }
+    }
+    pub fn tags(&self) -> &Tags {
+        match self {
+            Self::Node(n) => &n.tags,
+            Self::Way(w) => &w.tags,
+            Self::Relation(r) => &r.tags,
+        }
+    }
+}
+
+fn own_tags<'a>(tags: impl Iterator<Item = (&'a str, &'a str)>) -> Tags {
+    tags.map(|(k, v)| (k.to_owned(), v.to_owned())).collect()
+}
+
+fn own(element: Element<'_>) -> Result<OsmObj, Box<dyn std::error::Error>> {
+    Ok(match element {
+        Element::Node(n) => OsmObj::Node(Node {
+            id: NodeId(n.id()),
+            tags: own_tags(n.tags()),
+            lat: n.decimicro_lat(),
+            lon: n.decimicro_lon(),
+        }),
+        Element::DenseNode(n) => OsmObj::Node(Node {
+            id: NodeId(n.id()),
+            tags: own_tags(n.tags()),
+            lat: n.decimicro_lat(),
+            lon: n.decimicro_lon(),
+        }),
+        Element::Way(w) => OsmObj::Way(Way {
+            id: WayId(w.id()),
+            tags: own_tags(w.tags()),
+            nodes: w.refs().map(NodeId).collect(),
+        }),
+        Element::Relation(r) => {
+            let mut refs = Vec::new();
+            for m in r.members() {
+                let member = match m.member_type {
+                    RelMemberType::Node => OsmId::Node(NodeId(m.member_id)),
+                    RelMemberType::Way => OsmId::Way(WayId(m.member_id)),
+                    RelMemberType::Relation => OsmId::Relation(RelationId(m.member_id)),
+                };
+                refs.push(Member {
+                    member,
+                    role: m.role()?.to_owned(),
+                });
+            }
+            OsmObj::Relation(Relation {
+                id: RelationId(r.id()),
+                tags: own_tags(r.tags()),
+                refs,
+            })
+        }
+    })
+}
+
+fn retain_dependencies(
+    mut objects: BTreeMap<OsmId, OsmObj>,
+    relevant: impl Fn(&Tags) -> bool,
+) -> BTreeMap<OsmId, OsmObj> {
+    let mut pending: Vec<_> = objects
+        .iter()
+        .filter(|(_, o)| relevant(o.tags()))
+        .map(|(id, _)| *id)
+        .collect();
+    let mut seen = BTreeSet::new();
+    while let Some(id) = pending.pop() {
+        if !seen.insert(id) {
+            continue;
+        }
+        match objects.get(&id) {
+            Some(OsmObj::Way(w)) => pending.extend(w.nodes.iter().copied().map(OsmId::Node)),
+            Some(OsmObj::Relation(r)) => pending.extend(r.refs.iter().map(|m| m.member)),
+            _ => {}
+        }
+    }
+    // Missing references stay missing; downstream quality checks must still see them.
+    objects.retain(|id, _| seen.contains(id));
+    objects
+}
+
+pub fn read(
+    path: &str,
+    relevant: impl Fn(&Tags) -> bool,
+) -> Result<BTreeMap<OsmId, OsmObj>, Box<dyn std::error::Error>> {
+    // The caller supplies a small regional extract, never a country-sized file.
+    let mut objects = BTreeMap::new();
+    let mut conversion_error = None;
+    ElementReader::from_path(path)?.for_each(|element| {
+        if conversion_error.is_some() {
+            return;
+        }
+        match own(element) {
+            Ok(object) => {
+                objects.insert(object.id(), object);
+            }
+            Err(error) => conversion_error = Some(error),
+        }
+    })?;
+    if let Some(error) = conversion_error {
+        return Err(error);
+    }
+    Ok(retain_dependencies(objects, relevant))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn recursive_members_keep_dependencies_and_missing_references() {
+        let root = OsmId::Relation(RelationId(1));
+        let nested = OsmId::Relation(RelationId(2));
+        let way = OsmId::Way(WayId(3));
+        let node = OsmId::Node(NodeId(4));
+        let missing = OsmId::Node(NodeId(99));
+        let mut objects = BTreeMap::new();
+        objects.insert(
+            root,
+            OsmObj::Relation(Relation {
+                id: RelationId(1),
+                tags: [("route".into(), "tram".into())].into(),
+                refs: vec![Member {
+                    member: nested,
+                    role: "".into(),
+                }],
+            }),
+        );
+        objects.insert(
+            nested,
+            OsmObj::Relation(Relation {
+                id: RelationId(2),
+                tags: Tags::new(),
+                refs: vec![
+                    Member {
+                        member: root,
+                        role: "cycle".into(),
+                    },
+                    Member {
+                        member: way,
+                        role: "forward".into(),
+                    },
+                ],
+            }),
+        );
+        objects.insert(
+            way,
+            OsmObj::Way(Way {
+                id: WayId(3),
+                tags: Tags::new(),
+                nodes: vec![NodeId(4), NodeId(99)],
+            }),
+        );
+        for id in [4, 5] {
+            objects.insert(
+                OsmId::Node(NodeId(id)),
+                OsmObj::Node(Node {
+                    id: NodeId(id),
+                    tags: Tags::new(),
+                    lat: -123456789,
+                    lon: 123456789,
+                }),
+            );
+        }
+        let selected = retain_dependencies(objects, |tags| tags.contains_key("route"));
+        assert_eq!(
+            selected.keys().copied().collect::<Vec<_>>(),
+            vec![node, way, root, nested]
+        );
+        assert!(!selected.contains_key(&missing));
+        if let OsmObj::Way(w) = &selected[&way] {
+            assert_eq!(w.nodes, vec![NodeId(4), NodeId(99)]);
+        } else {
+            panic!("missing way");
+        }
+    }
+}
